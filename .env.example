# =============================================================================
# SIGM — Variables de entorno de PRODUCCIÓN (docker compose)
# Copie este archivo como .env y reemplace TODOS los valores de ejemplo.
# Nunca suba el archivo .env al repositorio.
# =============================================================================

# Base de datos PostgreSQL 18
POSTGRES_DB=sigm
POSTGRES_USER=sigm
POSTGRES_PASSWORD=CAMBIE_ESTA_CONTRASEÑA_LARGA_Y_ALEATORIA

# Red / publicación (acceso por la red interna de la clínica)
SIGM_HOSTNAME=sigm.clinica.local
HTTP_PORT=80
HTTPS_PORT=443

# Sesión y seguridad
SESSION_TTL_HOURS=10
LOGIN_RATE_LIMIT=10
MAX_UPLOAD_MB=15
SWAGGER_ENABLED=true
LOG_LEVEL=info

# Administrador inicial (la contraseña se genera aleatoriamente y se muestra una sola vez
# al ejecutar: docker compose exec api npm run create-admin)
ADMIN_USERNAME=admin
ADMIN_FULLNAME=Administrador del sistema

# Respaldos
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_CRON=0 2 * * *
BACKUP_RESTORE_TEST=weekly
